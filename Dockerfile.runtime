FROM node:22-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_OPTIONS=--max-old-space-size=768 \
    MALLOC_ARENA_MAX=2 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    ALSOFT_DRIVERS=null \
    VIEWER_PREFIX=/viewer

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl ffmpeg fonts-dejavu-core libasound2 libfontconfig1 \
      libgl1 libgl1-mesa-dri libglx-mesa0 libopenal1 libxcursor1 libxext6 \
      libxfixes3 libxi6 libxinerama1 libxrandr2 libxrender1 libxv1 libxxf86vm1 \
      openjdk-17-jdk-headless python3 x11-utils xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

ARG TARGETARCH
RUN npm ci \
    && ./build-observer.sh \
    && case "${TARGETARCH:-arm64}" in \
         arm64) native_platform=linux-arm64 ;; \
         amd64) native_platform=linux-x64 ;; \
         *) echo "unsupported container architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && python3 native-client/install.py --platform "$native_platform" \
    && ./native-client/build.sh \
    && curl -fsSL 'https://piston-data.mojang.com/v1/objects/1b557e7b033b583cd9f66746b7a9ab1ec1673ced/server.jar' -o /tmp/minecraft-server.jar \
    && echo '1b557e7b033b583cd9f66746b7a9ab1ec1673ced  /tmp/minecraft-server.jar' | sha1sum -c - \
    && install -D -m 0444 /tmp/minecraft-server.jar /opt/minecraft/server.jar \
    && rm /tmp/minecraft-server.jar \
    && groupadd --gid 10001 minecraft \
    && useradd --uid 10001 --gid minecraft --create-home --home-dir /home/minecraft --shell /usr/sbin/nologin minecraft \
    && mkdir -p /data/server /app/runs \
    && chown minecraft:minecraft /data/server /app/runs /app/native-client

ENV MC_SERVER_DIR=/data/server \
    MC_SERVER_JAR=/opt/minecraft/server.jar \
    OBSERVER_AGENT=/app/observer/dragon-observer.jar \
    DISPLAY=:99 \
    NATIVE_JAVA_XMX=768M

EXPOSE 3077 3078
USER minecraft
ENTRYPOINT ["/bin/bash", "/app/container/entrypoint.sh"]
